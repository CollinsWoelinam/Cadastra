# Copy to deploy/.env and fill in. Never commit the filled-in file.

# Public hostnames; both must point at this server for HTTPS certificates to issue.
PORTAL_DOMAIN=registry.example.gov.gh
API_DOMAIN=api.registry.example.gov.gh
ACME_EMAIL=ops@example.gov.gh

# Generate each with: openssl rand -hex 32
# (hex keeps the database password safe to embed in a connection URL)
POSTGRES_PASSWORD=
JWT_SECRET=

API_WORKERS=2

# Basemap raster tiles for the portal. The public OpenStreetMap servers do not allow
# production traffic; use a commercial provider or your own tile server.
BASEMAP_TILES=
BASEMAP_ATTRIBUTION=
