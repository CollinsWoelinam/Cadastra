# Copy to deploy/.env and fill in. Never commit the filled-in file.

# Public hostnames; both must point at this server for HTTPS certificates to issue.
PORTAL_DOMAIN=registry.example.gov.gh
API_DOMAIN=api.registry.example.gov.gh
ACME_EMAIL=ops@example.gov.gh

# Generate each with: openssl rand -hex 32
# (hex keeps the database password safe to embed in a connection URL)
POSTGRES_PASSWORD=
JWT_SECRET=

API_WORKERS=2

# Basemap raster tiles for the portal. The public OpenStreetMap servers do not allow
# production traffic; use a commercial provider or your own tile server.
BASEMAP_TILES=
BASEMAP_ATTRIBUTION=

# Local datum parameters from the Survey and Mapping Division, for the grid
# coordinates on survey plans. Leave empty to use the EPSG transformations
# (Accra ±6 m, Leigon ±5 m), which certificates then mark as indicative.
# Enter them exactly as published, from the local datum TO WGS 84:
#   "dx,dy,dz" in metres, or "dx,dy,dz,rx,ry,rz,ds" (metres, arc-seconds, ppm).
ACCRA_TO_WGS84=
LEIGON_TO_WGS84=
# Required with rotations: position_vector or coordinate_frame, as the publication states.
DATUM_ROTATION_CONVENTION=
# Required with any parameters; both are printed on survey plans.
DATUM_PARAMETERS_SOURCE=
DATUM_PARAMETERS_ACCURACY_M=
